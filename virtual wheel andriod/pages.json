{
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://doc.dcloud.net.cn/uni-app-x/collocation/pagesjson.html
		{
			"path": "pages/index/index",
			"style": {
				// navigationStyle: custom = 去掉系统自带的顶部导航栏（那一条只在 Web/App 默认样式下才有），
				// 页面自己画顶栏，并用 uni.getWindowInfo().statusBarHeight 给状态栏留出高度。
				"navigationStyle": "custom",
				"navigationBarTitleText": "虚拟方向盘"
			}
		},
		{
			"path": "pages/settings/settings",
			"style": {
				// 设置页同样去掉自带导航栏，页面里自己画「返回 + 标题」
				"navigationStyle": "custom",
				"navigationBarTitleText": "设置"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "虚拟方向盘",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}
